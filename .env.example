# Copy to .env (git-ignored) and fill in. Never commit real keys.
# Development uses fake data only: free-tier hosts can log prompts.

# Speech-to-text and text-to-speech (S2, S3)
SARVAM_API_KEY=

# Optional speech-to-text settings (defaults shown)
# STT_LANGUAGE=hi-IN        # hi-IN keeps English words in English; "unknown" auto-detects
# STT_MODE=codemix          # transcribe | codemix | translit | verbatim | translate
# STT_MODEL=saaras:v4
# STT_CODEC=pcm             # pcm | wav (only if raw PCM is ever rejected)
# STT_KEYTERMS=Chirp        # words to favour, comma separated; empty turns it off

# Optional text-to-speech settings (defaults shown)
# TTS_MODEL=bulbul:v3      # v3 has a published price; v4-flash does not yet
# TTS_SPEAKER=ritu         # a v3 voice such as shubh, priya, ritu
# TTS_PACE=1.0

# How Chirp sounds: sassy (default), warm or plain
# CHIRP_PERSONALITY=sassy

# Sounds and interrupting
# CHIRP_CUES=0             # turn the state sound cues off
# CHIRP_BARGE_IN=1         # let speaking over Chirp stop it (off by default, experimental)
# CHIRP_READBACK=on        # read back what Chirp heard (off by default now that it narrates)

# Credit guards. Sarvam's free credit is Rs 100.
# SARVAM_BUDGET_RUPEES=90       # speech calls stop at this estimated spend
# CHIRP_MAX_UTTERANCE_SECS=20   # audio past this is not sent

# Language model for the planner (S5). Any OpenAI-compatible chat endpoint with
# JSON-schema output. Providers are tried in this order, skipping any with no key:
#   LLM_PROVIDERS=custom,openai,sarvam       # default
# openai  uses OPENAI_API_KEY (model gpt-4.1-mini unless OPENAI_MODEL is set)
# sarvam  uses SARVAM_API_KEY and spends the same Rs 100 credit (sarvam-105b, about Rs 0.03 per step)
# custom  uses LLM_API_KEY with LLM_BASE_URL and LLM_MODEL, for Groq, Cerebras and so on
# Commands such as "open Notes" or "scroll down" need no model at all.
# Screen outlines and your requests are sent to whichever host answers.
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=
# LLM_MODEL=openai/gpt-oss-120b
# SARVAM_LLM_MODEL=sarvam-105b
